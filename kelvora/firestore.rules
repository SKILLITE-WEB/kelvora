rules_version='2';
service cloud.firestore { match /databases/{d}/documents {
 function me(){return request.auth!=null;}
 function admin(){return me()&&request.auth.token.email_verified&&request.auth.token.email in ['bendalehimanshu5@gmail.com','virajrajput07@gmail.com'];}
 function inT(t){return admin()||t.uid==request.auth.uid||('members' in t&&request.auth.uid in t.members);}
 match /users/{id}{allow read:if admin()||(me()&&request.auth.uid==id);allow write:if admin();}
 match /businesses/{id}{allow read:if resource.data.verified==true||admin()||(me()&&resource.data.uid==request.auth.uid);
  allow create:if me()&&request.resource.data.uid==request.auth.uid&&request.resource.data.verified==false&&request.resource.data.keys().hasOnly(['name','category','desc','link','uid','verified','t']);
  allow update:if admin()||(me()&&resource.data.uid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileStatus','submittedAt','threadId'])&&(!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileStatus'])||request.resource.data.profileStatus=='pending'));
  allow delete:if admin();}
 match /services/{id}{allow read:if true;allow write:if admin();}
 match /orders/{id}{allow read:if admin()||(me()&&resource.data.uid==request.auth.uid);
  allow create:if me()&&(admin()||(request.resource.data.uid==request.auth.uid&&request.resource.data.status=='requested'&&request.resource.data.paid==false));
  allow update:if admin()||(me()&&resource.data.uid==request.auth.uid&&resource.data.status=='quoted'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt'])&&request.resource.data.status in ['new','declined']);allow delete:if admin();}
 match /threads/{id}{allow read:if me()&&(resource==null||inT(resource.data));
  allow update:if admin()||(me()&&inT(resource.data)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','status']));
  allow create:if me()&&request.resource.data.uid==request.auth.uid&&(!id.matches('support_.*')||(id=='support_'+request.auth.uid&&request.resource.data.type=='support'))&&(request.resource.data.get('type','')!='b2b'||get(/databases/$(d)/documents/users/$(request.auth.uid)).data.verified==true)
   &&(request.resource.data.get('type','')=='b2b'?(request.resource.data.members.size()==2&&request.auth.uid in request.resource.data.members):request.resource.data.members==[request.auth.uid]);
  match /messages/{m}{allow read:if me()&&inT(get(/databases/$(d)/documents/threads/$(id)).data);
   allow create:if me()&&inT(get(/databases/$(d)/documents/threads/$(id)).data)
    &&(request.resource.data.from==request.auth.token.email||(request.resource.data.from=='system'&&request.resource.data.get('sys',false)==true&&(admin()||get(/databases/$(d)/documents/threads/$(id)).data.get('type','')=='support')))
    &&(admin()||!(request.resource.data.get('kind','') in ['pay','csv']));}}
 match /staff/{id}{allow read,write:if admin();}
 match /notices/{id}{allow read:if admin()||(me()&&resource.data.uid==request.auth.uid);allow create,delete:if admin();
  allow update:if admin()||(me()&&resource.data.uid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','status']));}
 match /scouts/{id}{allow read:if admin()||(me()&&resource.data.uid==request.auth.uid);allow write:if false;}
 match /drafts/{id}{allow read:if me()&&(resource==null||admin()||resource.data.uid==request.auth.uid);
  allow create:if me()&&request.resource.data.uid==request.auth.uid&&get(/databases/$(d)/documents/businesses/$(id)).data.uid==request.auth.uid;
  allow update:if admin()||(me()&&resource.data.uid==request.auth.uid&&request.resource.data.uid==resource.data.uid);allow delete:if admin();}
 match /images/{id}{allow get:if true;allow list:if admin();allow create:if me()&&request.resource.data.uid==request.auth.uid&&request.resource.data.data.size()<450000;allow delete:if admin()||(me()&&resource.data.uid==request.auth.uid);}
 match /bizPrivate/{id}{allow read:if admin()||(me()&&(resource==null||resource.data.uid==request.auth.uid));
  allow create:if admin()||(me()&&request.resource.data.uid==request.auth.uid&&get(/databases/$(d)/documents/businesses/$(id)).data.uid==request.auth.uid);
  allow update:if admin()||(me()&&resource.data.uid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']));
  allow delete:if admin();}
 match /finance/{id}{allow read,write:if admin();}
 match /work/{id}{allow read,write:if admin();}
}}
